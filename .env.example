# ============================================
# PropertyKING Backend Environment Variables
# ============================================

# App
APP_NAME=PropertyKING
APP_ENV=development
DEBUG=true
API_VERSION=v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# MongoDB
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/propertyking?retryWrites=true&w=majority
DATABASE_NAME=propertyking

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@propertyking.com

# Google Maps / Geocoding
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Admin Setup
ADMIN_EMAIL=admin@propertyking.com
ADMIN_PASSWORD=admin123456

# File Upload
MAX_FILE_SIZE_MB=10
MAX_IMAGES_PER_PROPERTY=20

# ============================================
# Property Sync (external listing import)
# ============================================
# Provider, interval, target markets, distressed-only etc. are configured in
# the ADMIN PANEL (Property Sync page) — not here. Only secrets live in this file.
#
# Leave RAPIDAPI_KEY empty to run the free "Demo Data" provider, which needs
# no key and works offline.
#
# For the Zillow provider you need BOTH:
#   1. a RapidAPI account key, and
#   2. an active subscription to the specific Zillow API (Basic plan is free)
#      at https://rapidapi.com/ReefAPI/api/zillow-real-estate-data-api/pricing
# Without step 2 every call returns 404 "API doesn't exists".
# Run `python probe_zillow.py` to check the key, the subscription and the quota.
RAPIDAPI_KEY=
ZILLOW_RAPIDAPI_HOST=zillow-real-estate-data-api.p.rapidapi.com

# Safety ceiling on API calls per sync run, so one misconfigured run cannot
# burn a whole month's quota.
ZILLOW_MAX_REQUESTS_PER_RUN=25

# AI notification copy (admin panel → Notifications → Generate)
OPENROUTER_API_KEY=
